# GitHub repository whose releases are mirrored (owner/name)
GITHUB_REPO=owner/linux-surface

# URL clients use to reach this repository (through your reverse proxy)
REPO_URL=https://repo.example.internal

# Space-separated Fedora versions to mirror
FEDORA_VERSIONS=43

# Number of releases to keep per Fedora version
KEEP=3

# Seconds between checks for new releases
INTERVAL=1800

# Host port nginx listens on
HTTP_PORT=8080
